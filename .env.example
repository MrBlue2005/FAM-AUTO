# Implicit serverul asculta doar local. Foloseste 0.0.0.0 numai in spatele unui firewall/reverse proxy.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RX_DATA_PATH=app/data
RX_LOGS_PATH=logs
RX_UPLOADS_PATH=app/uploads
RX_PROFILES_PATH=.

# Completeaza pentru un deployment accesibil din retea.
API_KEY=
TRUST_PROXY=false

# Autentificare recomandata local si obligatorie cand NODE_ENV=production.
AUTH_ENABLED=false
ADMIN_USERNAME=admin
# Configureaza local fara a scrie parola in comanda:
# $env:PASSWORD = Read-Host 'Parola'; npm.cmd run auth:setup; Remove-Item Env:PASSWORD
ADMIN_PASSWORD_SCRYPT=
# Optional hosted USER credential. Generate each Scrypt value with npm run auth:hash; never commit plaintext.
USER_USERNAME=
USER_PASSWORD_SCRYPT=
# RX_OPERATOR_API_TOKEN remains separate server/operator control-plane authentication, never dashboard login.

# Browserul ramane vizibil implicit. Pe Linux poate rula intr-o sesiune Xvfb.
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=300

# Hosted Local Agent (persistent, non-secret machine configuration). Never put a service-role key, operator token, enrollment token, or agent secret here.
RX_AGENT_TRANSPORT_MODE=HTTP
RX_AGENT_CLOUD_URL=https://rccefdsmvtsnpsaouzba.supabase.co/functions/v1/agent-protocol
RX_AGENT_REFERENCE_ALLOW_HTTP=false
RX_AGENT_CREDENTIAL_OVERLAP_SECONDS=900
# One-time enrollment: provide RX_AGENT_ENROLLMENT_TOKEN only in the launching terminal, never in .env. It is consumed by hosted enrollment and must be removed immediately afterwards.
