# Implicit serverul asculta doar local. Foloseste 0.0.0.0 numai in spatele unui firewall/reverse proxy.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RX_DATA_PATH=app/data
RX_LOGS_PATH=logs
RX_UPLOADS_PATH=app/uploads
RX_PROFILES_PATH=.

# Completeaza pentru un deployment accesibil din retea.
API_KEY=
TRUST_PROXY=false

# Autentificare optionala local, obligatorie cand NODE_ENV=production.
AUTH_ENABLED=false
ADMIN_USERNAME=admin
# Genereaza cu: $env:PASSWORD='parola-lunga'; npm run auth:hash; Remove-Item Env:PASSWORD
ADMIN_PASSWORD_SCRYPT=
# Compatibilitate temporara cu instalarile existente. Pentru VPS foloseste SCRYPT.
ADMIN_PASSWORD_SHA256=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_SCRYPT=
OPERATOR_PASSWORD_SHA256=

# Browserul ramane vizibil implicit. Pe Linux poate rula intr-o sesiune Xvfb.
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=300
