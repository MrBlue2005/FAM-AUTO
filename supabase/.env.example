# Custom Edge secret only; copy to an ignored .tmp file or use the hosted Dashboard.
# Hosted Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
# Do not upload SUPABASE_* variables or copy server secrets to Local Agent/browser env.
# Do not reuse the local live-validation operator token for hosted deployment.
RX_OPERATOR_API_TOKEN=generate-a-long-random-operator-token
