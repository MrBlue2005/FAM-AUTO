{
  "name": "facebook-automation",
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm --prefix dashboard-v2 run build",
    "start": "node --env-file-if-exists=.env server/server.js",
    "test": "node --test tests/core.test.js tests/server.test.js",
    "test:e2e": "node scripts/run-e2e.js",
    "check": "npm test && npm --prefix dashboard-v2 run lint && npm --prefix dashboard-v2 run build && npm run test:e2e",
    "check:production": "node --env-file-if-exists=.env scripts/production-check.js",
    "auth:hash": "node scripts/generate-password-hash.js",
    "server": "node --env-file-if-exists=.env server/server.js",
    "overlay:dev": "npm --prefix overlay-desktop run dev",
    "overlay:pack": "npm --prefix overlay-desktop run pack",
    "overlay:dist": "npm --prefix overlay-desktop run dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.2.0"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
