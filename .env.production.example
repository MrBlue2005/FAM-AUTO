NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true
CORS_ORIGINS=https://dashboard.example.com

# Directoare persistente, in afara checkoutului Git.
RX_DATA_PATH=/var/lib/fam-auto/data
RX_LOGS_PATH=/var/lib/fam-auto/logs
RX_UPLOADS_PATH=/var/lib/fam-auto/uploads
RX_PROFILES_PATH=/var/lib/fam-auto/profiles

# Loginul dashboardului este obligatoriu in productie.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SCRYPT=replace_with_saltHex:hashHex
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_SCRYPT=

# Optional pentru overlay sau clienti machine-to-machine. Nu o include in buildul Vite.
API_KEY=

# Pentru browser vizibil foloseste o sesiune grafica sau Xvfb pe Linux.
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=300
